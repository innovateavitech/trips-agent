{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "",
    "RabbitMq": ""
  },
  "Messaging": {
    "RetryLimit": 5
  },
  "Hangfire": {
    "SchemaName": "hangfire",
    "WorkerCount": 8
  },
  "Assets": {
    "VirusScanner": ""
  },
  "Suppliers": {
    "CredentialResolution": "PlatformOnly"
  },
  "SupplierApiCalls": {
    "RetentionMonths": 3,
    "PartitionsCreatedAhead": 3,
    "QueueCapacity": 5000,
    "BatchSize": 100,
    "ShutdownDrainTimeout": "00:00:10"
  }
}
