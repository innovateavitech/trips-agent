# Migrations are generated by `dotnet ef`, not written by hand.
#
# The repository treats warnings as errors, which is right for code we author and wrong for
# code a tool emits: EF's scaffolder writes block-scoped namespaces and its own layout, and
# "fixing" that by hand means re-fixing it after every single `migrations add`.
#
# So style rules are relaxed here and only here. Correctness analysers still apply — this
# turns off formatting opinions, not bug detection.

[*.cs]
generated_code = true

dotnet_diagnostic.IDE0161.severity = none   # block-scoped namespace
dotnet_diagnostic.IDE0055.severity = none   # general formatting
dotnet_diagnostic.IDE0005.severity = none   # unnecessary using directives
dotnet_diagnostic.IDE0040.severity = none   # accessibility modifiers
dotnet_diagnostic.CA1861.severity  = none   # constant arrays as arguments
