<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TripsAgent.Application\TripsAgent.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Design is what makes `dotnet ef` work, and it defines the
         IDesignTimeDbContextFactory we implement in Persistence/. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <!-- Migrations live in db/migrations/ at the repository root, not inside this project.
       That is a deliberate choice recorded in README §6: the schema's history is the thing
       a reviewer most often wants to read, and burying it four directories deep inside a
       C# project hides it.

       MSBuild only compiles files underneath the project directory, so they have to be
       included by hand. Without this line the generated migrations sit on disk looking
       correct and EF Core cannot see a single one of them.

       Use scripts/new-migration.sh to generate one — it passes the output directory and the
       namespace that keep this working. -->
  <ItemGroup>
    <Compile Include="..\..\db\migrations\**\*.cs">
      <Link>Migrations\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
