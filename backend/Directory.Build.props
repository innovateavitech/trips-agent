<Project>

  <!-- Applies to every project in the solution. See docs/adr/ for the reasoning. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning today is a bug next month. Fix it now. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Known-vulnerable packages (issue #108). Restore still checks every package, transitive ones
       included, and prints NU1901-NU1904 as warnings. They are not errors here, even with
       TreatWarningsAsErrors, because the gate is one named CI job: audit-api, which runs
       scripts/audit_dependencies.py and fails on High or Critical.

       If restore failed as well, an advisory published overnight would break every build, test
       and migration job at once with an error that never mentions the runbook, and even a Low
       would do it. It would also leave a tolerated advisory needing to be suppressed in two
       places. One gate, one allowlist (VulnerabilityAllowlist.txt), one runbook:
       docs/runbooks/vulnerable-dependency.md -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Money must never be floating point. These null-safety warnings are real bugs. -->
  <PropertyGroup>
    <WarningsAsErrors>
      $(WarningsAsErrors);
      CS8600; <!-- null assigned to non-nullable -->
      CS8602; <!-- dereference of a possibly-null reference -->
      CS8603; <!-- possible null reference return -->
      CS8618  <!-- non-nullable field left uninitialised -->
    </WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The money-type analyser, TRIPS001 (issue #9): the build fails when something named like
       money — *Amount, *Price, *Fare, *Balance, *Fee, *Minor — is a decimal, double or float.
       Loaded into the compiler as an analyser rather than referenced as a library, so nothing
       ships with it. The only exceptions live in MoneyTypeAllowlist.txt, next to this file.
       Skipped for the analyser itself (it cannot analyse its own build) and for its tests,
       which reference it as an ordinary library instead. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'TripsAgent.Analyzers' and '$(MSBuildProjectName)' != 'TripsAgent.AnalyzerTests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/TripsAgent.Analyzers/TripsAgent.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)MoneyTypeAllowlist.txt" />

    <!-- TRIPS002 fails the build when production code calls IgnoreQueryFilters(), which reads
         every agency's rows at once (CLAUDE.md rule 3). Same analyser project, same allowlist
         shape; its exceptions live in IgnoreQueryFiltersAllowlist.txt, which is empty. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)IgnoreQueryFiltersAllowlist.txt" />
  </ItemGroup>

  <!-- Sync-conflict copies. iCloud Desktop sync and Dropbox leave "Foo 2.cs" beside "Foo.cs", and
       every *.cs is compiled — so one copy produces a wall of CS0101 "already contains a definition"
       errors that never mention the cause, while .gitignore keeps git status looking clean.

       This stops the build first and names the files. It deliberately deletes nothing: a conflict
       copy can hold an edit that exists nowhere else, so a person compares before removing it. -->
  <Target Name="RejectSyncConflictCopies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_SyncConflictCopy Include="@(Compile)"
                         Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', ' \d+$'))" />
    </ItemGroup>
    <Error Condition="'@(_SyncConflictCopy)' != ''"
           Text="Sync-conflict copies found — files like 'Foo 2.cs' left beside 'Foo.cs' by iCloud or Dropbox, each redefining a type: @(_SyncConflictCopy->'%(Identity)', ', '). Compare each with its original (cmp 'Foo 2.cs' Foo.cs) and delete it if identical. If it differs, it may hold an edit that exists nowhere else — look before deleting." />
  </Target>

</Project>
