<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- ModelConventionTests.HasADecimal is a probe entity that declares a decimal price ON
         PURPOSE, to prove the EF Core convention rejects a decimal column. TA0001 is right to
         flag it and wrong to fail the build over it — the violation is the test. -->
    <TripsAgentMoneyAllowedMembers>HasADecimal.Price</TripsAgentMoneyAllowedMembers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <!-- IDesignTimeDbContextFactory lives here. It is a developmentDependency, so it does not
         flow through the Infrastructure project reference and has to be named again. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\services\TripsAgent.Domain\TripsAgent.Domain.csproj" />
    <ProjectReference Include="..\..\services\TripsAgent.Application\TripsAgent.Application.csproj" />
    <ProjectReference Include="..\..\services\TripsAgent.Infrastructure\TripsAgent.Infrastructure.csproj" />
  </ItemGroup>

</Project>
