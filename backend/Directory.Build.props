<Project>

  <!-- Applies to every project in the solution. See docs/adr/ for the reasoning. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning today is a bug next month. Fix it now. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Money must never be floating point. These null-safety warnings are real bugs. -->
  <PropertyGroup>
    <WarningsAsErrors>
      $(WarningsAsErrors);
      CS8600; <!-- null assigned to non-nullable -->
      CS8602; <!-- dereference of a possibly-null reference -->
      CS8603; <!-- possible null reference return -->
      CS8618  <!-- non-nullable field left uninitialised -->
    </WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- TA0001: money must not be decimal/double/float. Wired in here rather than per-project so
       a new project cannot be created without it — the guard you have to remember to add is the
       guard that is missing from the one project that needed it.

       The analyser project is excluded because a project cannot analyse itself, and its test
       project because it holds deliberate violations as source strings. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'TripsAgent.Analyzers'
                    and '$(MSBuildProjectName)' != 'TripsAgent.AnalyzerTests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers\TripsAgent.Analyzers\TripsAgent.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The TA0001 allowlist. Empty here on purpose — a project that genuinely holds a
       non-money member ending in Amount/Price/Fare/Balance/Fee sets this in its OWN csproj,
       so the exemption is reviewed by whoever owns that code:

           <TripsAgentMoneyAllowedMembers>TypeName.MemberName</TripsAgentMoneyAllowedMembers>

       Qualify it with the type wherever you can. A bare member name exempts that name in every
       type in the project, which is almost never what you meant. -->
  <PropertyGroup>
    <TripsAgentMoneyAllowedMembers Condition="'$(TripsAgentMoneyAllowedMembers)' == ''"></TripsAgentMoneyAllowedMembers>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="TripsAgentMoneyAllowedMembers" />
  </ItemGroup>

</Project>
