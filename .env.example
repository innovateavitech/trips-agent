# =============================================================================
#  Trips Agent Platform — environment template
# =============================================================================
#
#  scripts/setup.sh copies this file to .env on first run. .env is git-ignored;
#  this template is the only one committed.
#
#    ./scripts/setup.sh      creates .env from this file
#    docker compose up -d    reads the INFRASTRUCTURE section below
#
#  Everything in the INFRASTRUCTURE section works as-is for local development —
#  you do not need to edit it. Only the THIRD-PARTY section needs real values,
#  and only once you start work that actually calls those providers.
#
#  ⚠  Never put a real key in this file. It is committed. If a real key ever
#     lands here, rotate it — removing the line does not remove it from git
#     history. See CLAUDE.md rule 8.
#
#  Naming: infrastructure uses flat NAMES (Docker Compose reads these), and
#  application settings use Section__Key, which is how .NET binds environment
#  variables to IOptions. The double underscore is required, not a typo.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  Application
# -----------------------------------------------------------------------------

# Development enables Swagger, detailed errors and the Hangfire dashboard.
# Never set this to Development outside your own machine.
ASPNETCORE_ENVIRONMENT=Development

# The API listens here. Swagger is at /swagger, Hangfire at /hangfire.
API_PORT=5000

# Front-end dev-server ports. These must match README §8, because the API's
# CORS policy is built from them.
AGENT_CONSOLE_PORT=5173
ADMIN_CONSOLE_PORT=5174
STOREFRONT_PORT=3000

# Where the browser should reach the API. The front ends read this at build time.
VITE_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Pages on the agent console that the API sends people to, so they have to be
# absolute and they have to be right — an email or a payment gateway follows
# them, and neither has any idea what host the console is on.
Console__PasswordResetUrl=http://localhost:5173/reset-password
# Where Paystack returns the payer after checkout. The console then asks the API
# to verify; it never reads the outcome from the redirect's query string, which
# is the payer's browser talking rather than the gateway.
Console__TopUpCallbackUrl=http://localhost:5173/wallet/top-up/complete


# =============================================================================
#  INFRASTRUCTURE — these defaults work as-is. docker compose reads them.
# =============================================================================

# -----------------------------------------------------------------------------
#  PostgreSQL 16
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
# Already running Postgres on 5432? Change this rather than stopping the other
# one — README §7 "When it goes wrong" covers the port clash.
POSTGRES_PORT=5432
POSTGRES_DB=trips_agent
POSTGRES_USER=trips
# Local-only throwaway credential. The real one lives in the deployment secret
# store, never in a file.
POSTGRES_PASSWORD=trips_local_dev

# What the .NET side actually connects with. If you change any value above,
# change it here too — they are not derived from each other.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=trips_agent;Username=trips;Password=trips_local_dev
# The schema owner's connection, for migrations and DDL only (ADR-0006). Unset, it falls back to
# ConnectionStrings__Postgres, which is what local development does by default. In a deployed
# environment, ConnectionStrings__Postgres is the tripsagent_app role that row-level security
# polices, and this is the owner — a superuser or a BYPASSRLS role.
ConnectionStrings__PostgresAdmin=

# -----------------------------------------------------------------------------
#  Redis 7 — supplier search cache and storefront domain lookups
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# -----------------------------------------------------------------------------
#  RabbitMQ 3 — MassTransit transport for sagas and background messages
# -----------------------------------------------------------------------------

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Management UI: http://localhost:15672 — log in with the user/password below.
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=trips
RABBITMQ_PASSWORD=trips_local_dev
RABBITMQ_VHOST=/

ConnectionStrings__RabbitMq=amqp://trips:trips_local_dev@localhost:5672/

# How hard a failed message is retried (exponential backoff) before MassTransit
# moves it to <queue>_error. 0 means straight to the dead-letter queue.
Messaging__RetryLimit=5

# -----------------------------------------------------------------------------
#  Outbox — how domain events get from PostgreSQL to RabbitMQ (docs/adr/0005)
# -----------------------------------------------------------------------------
#  Every setting has a working default; these lines only show the knobs. The
#  Worker publishes platform.outbox_messages every PollInterval (1–5 seconds
#  allowed). Past either backlog threshold it logs a warning (an error at the
#  critical level) and the API's /health reports Degraded.

Outbox__PollInterval=00:00:02
Outbox__BatchSize=50
Outbox__PublishTimeout=00:00:10
Outbox__MaxAttempts=10
Outbox__BacklogWarningCount=500
Outbox__BacklogCriticalCount=5000
Outbox__BacklogWarningAge=00:01:00
Outbox__BacklogCriticalAge=00:10:00

# -----------------------------------------------------------------------------
#  Hangfire — recurring jobs, and the dashboard at /hangfire
# -----------------------------------------------------------------------------
#  Uses the Postgres connection string above; its tables live in their own schema.
#  The dashboard can requeue jobs that move money, so it is off unless enabled and
#  requires a signed-in platform-admin. The local-requests flag is honoured in
#  Development only — behind a load balancer every request looks local.

Hangfire__DashboardEnabled=true
Hangfire__AllowLocalRequestsWithoutAuthentication=true

# -----------------------------------------------------------------------------
#  MinIO — S3-compatible blob storage behind IBlobStorage
# -----------------------------------------------------------------------------
#  Cloud is not chosen yet (CLAUDE.md), so storage goes through a port and MinIO
#  stands in for whatever object store we land on.

MINIO_PORT=9000
# Web console for browsing uploaded files: http://localhost:9001
MINIO_CONSOLE_PORT=9001
# MinIO refuses to start if these are shorter than 3 and 8 characters.
MINIO_ROOT_USER=trips_local
MINIO_ROOT_PASSWORD=trips_local_dev

Storage__Endpoint=http://localhost:9000
Storage__Bucket=trips-assets
Storage__AccessKey=trips_local
Storage__SecretKey=trips_local_dev
# TLS is off locally and must be on everywhere else.
Storage__UseSsl=false

# -----------------------------------------------------------------------------
#  Mailpit — catches every outbound email so nothing reaches a real inbox
# -----------------------------------------------------------------------------
#  Read what the platform sent at http://localhost:8025. Mailpit accepts any
#  credentials, which is why the user and password below are blank.

SMTP_PORT=1025
MAILPIT_UI_PORT=8025

Email__Host=localhost
Email__Port=1025
Email__User=
Email__Password=
Email__UseSsl=false
# Traveller-facing mail is sent under the agent's own brand (CLAUDE.md rule 4).
# This address is only the fallback for platform mail to agents themselves.
Email__FromAddress=no-reply@trips.local
Email__FromName=Trips Agent Platform


# =============================================================================
#  THIRD-PARTY — replace before working on anything that calls these
# =============================================================================

# -----------------------------------------------------------------------------
#  Authentication
# -----------------------------------------------------------------------------

# HMAC-SHA256 signing key. Must be at least 32 characters or token issuance
# throws at startup. Generate your own: openssl rand -base64 48
# A blank or missing value is why "the front end 401s on everything".
Jwt__SigningKey=dev-only-insecure-key-REPLACE-ME-32-chars-min
Jwt__Issuer=https://localhost:5000
Jwt__Audience=trips-agent-platform
# Short-lived access token, long-lived rotating refresh token (issue #16).
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# AES-256 key that encrypts supplier merchant keys at rest (supplier_credentials).
# Exactly 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Losing it makes every stored supplier credential unreadable; never commit a real one.
Security__SecretEncryptionKey=

# -----------------------------------------------------------------------------
#  Paystack — wallet top-ups and traveller payments (test mode)
# -----------------------------------------------------------------------------
#  Test keys: dashboard.paystack.com → Settings → API Keys & Webhooks.
#  Test keys start sk_test_ / pk_test_. A key starting sk_live_ moves real
#  money — it must never appear in a .env on a developer machine.

Paystack__BaseUrl=https://api.paystack.co
Paystack__SecretKey=sk_test_REPLACE_ME
Paystack__PublicKey=pk_test_REPLACE_ME
#
#  There is deliberately no separate webhook secret here. Paystack signs the
#  x-paystack-signature header with the secret key above (HMAC SHA-512 over the
#  raw request body), so SecretKey is the signing key too. One consequence worth
#  knowing: rotating the secret key invalidates webhooks already in flight.
#
#  The webhook endpoint is POST /api/v1/webhooks/paystack. Register it on the
#  Paystack dashboard. It is anonymous — the signature is the authentication —
#  and it cannot be reached on localhost, so use a tunnel to test deliveries.
#
#  Defence in depth: Paystack only ever sends webhooks from 52.31.139.75,
#  52.49.173.169 and 52.214.14.220. Allowlist those at the ingress or firewall
#  rather than in the application, which would otherwise see the load balancer's
#  address unless it trusted forwarded headers — and trusting those on a public
#  endpoint is its own way in.

# -----------------------------------------------------------------------------
#  Alerting — where a P1 from a background job goes
# -----------------------------------------------------------------------------
#  Empty is fine locally: there is nowhere to send it, and nothing fails. In a
#  deployed environment set it, because a P1 with no recipient is only written
#  to the log — and the nightly ledger integrity audit raises P1 for exactly the
#  conditions that should be impossible.
#
#  Alerts are always logged at Critical and always queued to platform.admin_alerts
#  for the back-office widget, whether or not this is set.

Alerting__P1Recipient=

# -----------------------------------------------------------------------------
#  Trips Africa — the flight and bus supplier (staging)
# -----------------------------------------------------------------------------
#  Ask the team lead for staging credentials. See docs/TRIPS_AFRICA_API_NOTES.md.
#  Note there are no webhooks: booking outcomes are polled.

TripsAfrica__BaseUrl=https://api.staging.trips.ng
TripsAfrica__MerchantCode=REPLACE_ME
TripsAfrica__MerchantKey=REPLACE_ME
# Ticket issuance is not idempotent and is never retried (ADR-0003), so this
# timeout only bounds the wait — a timeout is an unknown outcome, resolved by
# polling GetBookingStatus.
TripsAfrica__TimeoutSeconds=60

# Which merchant account an agency's supplier calls use — open question 1 in the
# delivery plan. PlatformOnly (default): always the platform's credential.
# AgencyFirst: the agency's own credential when it has one, else the platform's.
Suppliers__CredentialResolution=PlatformOnly
# supplier_api_calls keeps whole months; 3 gives the plan's 90 days of hot history.
SupplierApiCalls__RetentionMonths=3
SupplierApiCalls__PartitionsCreatedAhead=3
# The call log is written off the request path through an in-memory buffer. Past QueueCapacity a
# call is logged at Error and counted instead of buffered; a stopping host spends up to
# ShutdownDrainTimeout writing what is left.
SupplierApiCalls__QueueCapacity=5000
SupplierApiCalls__BatchSize=100
SupplierApiCalls__ShutdownDrainTimeout=00:00:10


# =============================================================================
#  SEED DATA — the accounts in README §9
# =============================================================================
#  Created by: dotnet run --project services/TripsAgent.Api -- seed
#  Seeding refuses to run unless ASPNETCORE_ENVIRONMENT=Development.

Seed__AdminPassword=DevAdmin_1
Seed__AgentPassword=DevAgent_1
Seed__SubAgentPassword=DevSubAgent_1
Seed__PendingAgentPassword=DevPending_1


# =============================================================================
#  AUDIT LOG — retention for platform.audit_logs
# =============================================================================
#  Months of history kept before whole monthly partitions are dropped. 84 (seven
#  years) is a placeholder, not a decision: open question 26 in the delivery plan
#  weighs financial-record retention against the NDPA right to erasure.

AuditLog__RetentionMonths=84

#  Future months kept ready. If `audit-maintenance` stops running, this is how
#  many months pass before every audited save fails. See docs/runbooks/audit-log.md.
AuditLog__PartitionsCreatedAhead=3
