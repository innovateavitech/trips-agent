  "components": {
    "schemas": {
      "AssetLinkResponse": {
        "required": [
          "kind",
          "url",
          "contentType",
          "width",
          "height",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssetPurposeLimitsResponse": {
        "required": [
          "purpose",
          "maxSizeBytes",
          "allowedContentTypes",
          "allowedExtensions"
        ],
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string"
          },
          "maxSizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "allowedContentTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AssetResponse": {
        "required": [
          "id",
          "purpose",
          "fileName",
          "status",
          "scanStatus",
          "contentType",
          "sizeBytes",
          "width",
          "height",
          "failureReason",
          "createdAt",
          "links"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "scanStatus": {
            "type": "string"
          },
          "contentType": {
            "type": [
              "null",
              "string"
            ]
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetLinkResponse"
            }
          }
        }
      },
      "AssetUploadLimitsResponse": {
        "required": [
          "purposes"
        ],
        "type": "object",
        "properties": {
          "purposes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetPurposeLimitsResponse"
            }
          }
        }
      },
      "AssetUploadResponse": {
        "required": [
          "assetId",
          "uploadUrl",
          "method",
          "headers",
          "maxSizeBytes",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadUrl": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "maxSizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "userId",
          "email",
          "agencyId",
          "agencyName",
          "roles"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "agencyId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "agencyName": {
            "type": [
              "null",
              "string"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EmailVerifiedResponse": {
        "required": [
          "message"
        ],
