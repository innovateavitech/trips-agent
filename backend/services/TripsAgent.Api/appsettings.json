{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "RabbitMq": ""
  },
  "Messaging": {
    "RetryLimit": 5
  },
  "Hangfire": {
    "SchemaName": "hangfire",
    "DashboardEnabled": false,
    "DashboardRole": "platform-admin",
    "AllowLocalRequestsWithoutAuthentication": false
  },
  "AuditLog": {
    "RetentionMonths": 84,
    "PartitionsCreatedAhead": 3
  }
}
