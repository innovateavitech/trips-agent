# Keeps formatting consistent across macOS, Windows and every editor.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{cs,csx}]
indent_size = 4

# --- C# conventions (enforced by `dotnet format`) ---
[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:warning

# Treat these as errors — they catch real bugs, not style preferences
dotnet_diagnostic.CA2007.severity = none    # ConfigureAwait not needed in ASP.NET Core

# Performance analysers: useful guidance, but not worth failing a build over.
# Demoted to suggestions so they inform without blocking.
dotnet_diagnostic.CA1848.severity = suggestion  # prefer LoggerMessage delegates
dotnet_diagnostic.CA1727.severity = suggestion  # PascalCase log placeholders
dotnet_diagnostic.CA1812.severity = suggestion  # uninstantiated internal class
dotnet_diagnostic.CA1873.severity = suggestion  # argument may be expensive if logging is off
dotnet_diagnostic.CS8600.severity = error   # null assigned to non-nullable
dotnet_diagnostic.CS8602.severity = error   # dereference of a possible null
dotnet_diagnostic.CS8618.severity = error   # non-nullable field left uninitialised

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

[*.{csproj,props,targets,config,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # two trailing spaces mean "line break" in markdown
max_line_length = off

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
end_of_line = lf

# --- Test projects ---------------------------------------------------------
# CA1711 reserves a handful of type-name suffixes — Permission, Flags, Delegate — from the
# .NET Framework's old code-access-security types. "Permission" is simply the right word for a
# thing a user is allowed to do, and renaming the domain to appease a rule about a dead API
# would make the model harder to read, not safer.
[backend/services/TripsAgent.Domain/**/*.cs]
dotnet_diagnostic.CA1711.severity = none

# Underscored test names (Thing_should_do_other_thing) are the convention and
# read far better than PascalCase in a test explorer. The analyser disagrees;
# the analyser is wrong for tests.
[backend/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none    # underscores in member names
dotnet_diagnostic.CA1515.severity = none    # types can be public in test projects
dotnet_diagnostic.CA1711.severity = none    # xUnit collection fixtures end in 'Collection'
