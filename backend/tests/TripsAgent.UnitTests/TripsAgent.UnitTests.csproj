<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <!-- IDesignTimeDbContextFactory lives here. It is a developmentDependency, so it does not
         flow through the Infrastructure project reference and has to be named again. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <!-- ConfigurationBuilder and AddInMemoryCollection, for testing registration that reads
         IConfiguration. Infrastructure only brings the abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\services\TripsAgent.Domain\TripsAgent.Domain.csproj" />
    <ProjectReference Include="..\..\services\TripsAgent.Application\TripsAgent.Application.csproj" />
    <ProjectReference Include="..\..\services\TripsAgent.Infrastructure\TripsAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\..\services\TripsAgent.Integrations.Paystack\TripsAgent.Integrations.Paystack.csproj" />
    <ProjectReference Include="..\..\services\TripsAgent.Integrations.TripsAfrica\TripsAgent.Integrations.TripsAfrica.csproj" />
  </ItemGroup>

</Project>
