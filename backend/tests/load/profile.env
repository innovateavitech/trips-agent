# =============================================================================
#  The load-test profile (issue 109): how the API is configured for a load test.
# =============================================================================
#
#  run.sh reads this file and starts the API with it. Nothing in the application
#  code knows a load test exists — every line below is ordinary configuration
#  that any environment could set.
#
#  Everything here is throwaway and points only at the load-test stack in
#  docker-compose.yml. None of it is a secret, and none of it may be copied into
#  a real environment.
# =============================================================================

# Not Development: Development switches rate limiting off and logs every SQL
# command, which would measure the logger. Not Production either, which refuses to
# start with development keys. A named environment of its own, with no
# appsettings file behind it — so everything it needs is listed here.
ASPNETCORE_ENVIRONMENT=LoadTest
ASPNETCORE_URLS=http://127.0.0.1:5090

# As production connects: the runtime role, which row-level security binds
# (ADR-0006), and the owner role for migrations only. run.sh gives the runtime
# role this password after migrating.
ConnectionStrings__Postgres=Host=127.0.0.1;Port=55432;Database=trips_loadtest;Username=tripsagent_app;Password=loadtest_app_only
ConnectionStrings__PostgresAdmin=Host=127.0.0.1;Port=55432;Database=trips_loadtest;Username=trips;Password=trips_loadtest_only
ConnectionStrings__Redis=127.0.0.1:56379
ConnectionStrings__RabbitMq=amqp://trips:trips_loadtest_only@127.0.0.1:55672/

Logging__LogLevel__Default=Warning

# Rate limiting stays ON, so its Redis round trips are part of what is measured.
# Only the two limits a load test must exceed are raised: one signed-in user
# stands in for the hundreds of agents who would really be searching, so the
# per-user search limit (30 a minute) and the per-agency ceiling (1,200 a minute)
# would otherwise answer 429 within seconds and the test would measure refusals.
RateLimiting__Enabled=true
RateLimiting__Policies__Search__PermitLimit=1000000
RateLimiting__Policies__Agency__PermitLimit=1000000
# The seeded user signs in once per run, from one address.
RateLimiting__Policies__Login__PermitLimit=1000

# The development-only keys from appsettings.Development.json, which is not loaded
# under this environment. They are public in the repository and sign nothing real.
Jwt__Issuer=https://localhost:5001
Jwt__Audience=trips-agent-api
Jwt__SigningKey=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2lnbmluZy1rZXktbm90LWZvci1wcm9k
Jwt__AccessTokenMinutes=30
Security__TokenHashKey=ZGV2ZWxvcG1lbnQtb25seS1rZXktbmV2ZXItdXNlLWluLXByb2R1Y3Rpb24h
# 32 bytes that spell "loadtest-only-key-not-a-secret!!". The supplier credential
# fallback below is what search uses, so nothing is ever encrypted with it.
Security__SecretEncryptionKey=bG9hZHRlc3Qtb25seS1rZXktbm90LWEtc2VjcmV0ISE=

# The supplier is the WireMock stub. The credential is a placeholder the stub
# accepts; the real Trips Africa API is never reachable from this profile.
TripsAfrica__BaseUrl=http://127.0.0.1:58089/
TripsAfrica__MerchantCode=LOADTEST
TripsAfrica__MerchantKey=not-a-real-key
TripsAfrica__BearerToken=not-a-real-one

Smtp__Host=127.0.0.1
Smtp__Port=1025
Smtp__SecureSocket=None
Smtp__FromAddress=no-reply@loadtest.invalid
Smtp__WhiteLabelFromAddress=bookings@loadtest.invalid
